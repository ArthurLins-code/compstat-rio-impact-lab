# Mantém o contexto de build pequeno.

# Controle de versão
.git
.gitignore

# Python local
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache

# Node local
**/node_modules
**/dist
**/.vite

# OS
.DS_Store
Thumbs.db

